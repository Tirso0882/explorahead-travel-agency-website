# ===========================================
# ExplorAhead Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# Set these variables in Vercel Dashboard for production

# ===========================================
# SENTRY - Error Tracking & Monitoring
# ===========================================
# Get from https://sentry.io → Project Settings → Client Keys (DSN)

# Public DSN for client-side error reporting (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Server-side DSN (same as public for Next.js)
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Auth token for source maps upload (Settings > Auth Tokens)
# Create token with: org:read, project:read, project:releases, project:write
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Organization slug (from the Sentry URL)
# SENTRY_ORG=your_sentry_org_slug

# Project slug (from the Sentry project settings)
# SENTRY_PROJECT=explorahead

# ===========================================
# GOOGLE ANALYTICS 4
# ===========================================
# Get from https://analytics.google.com
# Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# APPLICATION
# ===========================================
# Public app name
NEXT_PUBLIC_APP_NAME=ExplorAhead

# Base URL for the application (used for sitemap, OG images, etc.)
NEXT_PUBLIC_BASE_URL=https://explorahead.com

# ===========================================
# RESEND - Email Service
# ===========================================
# API key for sending emails (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to send from
# For testing: use onboarding@resend.dev
# For production: verify your domain at resend.com and use noreply@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin email to receive contact form notifications
# IMPORTANT: Must match the email you used to sign up for Resend (for testing)
ADMIN_EMAIL=your.email@example.com

# ===========================================
# NEON POSTGRES - Database
# ===========================================
# Database connection string from https://neon.tech
# Dashboard > Project > Connection Details
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/database?sslmode=require&channel_binding=require

# ===========================================
# VERCEL (Auto-populated by Vercel)
# ===========================================
# These are automatically set by Vercel - no need to configure manually
# VERCEL_URL
# VERCEL_ENV
# VERCEL_GIT_COMMIT_SHA
